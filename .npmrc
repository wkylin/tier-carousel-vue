# Strict Team Profile (CI friendly)

# Enforce Node version from package.json engines.
engine-strict=true

# Keep installs deterministic.
save-exact=true
package-lock=false
prefer-frozen-lockfile=false
frozen-lockfile=false

# Be strict about peer dependency correctness.
strict-peer-dependencies=true
auto-install-peers=false

# Keep security checks enabled.
audit=true

# Reduce noisy terminal output.
fund=false
update-notifier=false
